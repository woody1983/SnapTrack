    <!-- Barcode Scanner Overlay -->
    <div class="scanner-overlay" id="scannerOverlay">
      <div class="scanner-header">
        <span class="scanner-title">Scan Barcode</span>
        <button class="scanner-close" id="scannerClose">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      
      <div class="scanner-container">
        <video class="scanner-video" id="scannerVideo" playsinline></video>
        <div class="scanner-frame">
          <div class="scanner-laser"></div>
        </div>
        <div class="scanner-hint">Align barcode within the frame</div>
      </div>
      
      <div class="scanner-footer">
        <div class="scanner-status">
          <span class="scanner-status-dot"></span>
          <span>Scanning...</span>
        </div>
        <button class="scanner-manual-btn" id="scannerManualBtn">Enter Manually</button>
      </div>

      <!-- Manual Input Panel -->
      <div class="manual-input-panel" id="manualInputPanel">
        <div class="manual-input-title">Enter Tracking Number</div>
        <input 
          type="text" 
          class="manual-input-field" 
          id="manualInputField" 
          placeholder="e.g., 1Z1234567890123456"
          maxlength="30"
        />
        <div class="manual-input-buttons">
          <button class="manual-input-btn cancel" id="manualCancelBtn">Cancel</button>
          <button class="manual-input-btn confirm" id="manualConfirmBtn">Confirm</button>
        </div>
      </div>
    </div>

    <script type="module">
      import { BrowserMultiFormatReader, BarcodeFormat } from 'https://cdn.jsdelivr.net/npm/@zxing/browser@0.1.5/+esm';
      import { DecodeHintType } from 'https://cdn.jsdelivr.net/npm/@zxing/library@0.21.3/+esm';

      // DOM Elements
      const trackingInput = document.getElementById("trackingInput");
      const searchBtn = document.getElementById("searchBtn");
      const cameraBtn = document.getElementById("cameraBtn");
      const statusLoading = document.getElementById("statusLoading");
      const statusSuccess = document.getElementById("statusSuccess");
      const statusError = document.getElementById("statusError");
      const successDetail = document.getElementById("successDetail");
      
      // Scanner Elements
      const scannerOverlay = document.getElementById("scannerOverlay");
      const scannerClose = document.getElementById("scannerClose");
      const scannerVideo = document.getElementById("scannerVideo");
      const scannerManualBtn = document.getElementById("scannerManualBtn");
      const manualInputPanel = document.getElementById("manualInputPanel");
      const manualInputField = document.getElementById("manualInputField");
      const manualCancelBtn = document.getElementById("manualCancelBtn");
      const manualConfirmBtn = document.getElementById("manualConfirmBtn");
      
      // Scan Result Modal Elements
      const scanResultModal = document.getElementById("scanResultModal");
      const scanResultTracking = document.getElementById("scanResultTracking");
      const scanResultCarrier = document.getElementById("scanResultCarrier");
      const scanResultRaw = document.getElementById("scanResultRaw");
      const scanResultCancel = document.getElementById("scanResultCancel");
      const scanResultSave = document.getElementById("scanResultSave");

      let codeReader = null;
      let scannerControls = null;
      let isScanning = false;
      let pendingScanData = null;

      // Hide all status cards
      function hideAllStatus() {
        statusLoading.classList.remove("show");
        statusSuccess.classList.remove("show");
        statusError.classList.remove("show");
      }

      // Show loading status
      function showLoading() {
        hideAllStatus();
        statusLoading.classList.add("show");
      }

      // Show success status
      function showSuccess(timestamp) {
        hideAllStatus();
        successDetail.textContent = `Entry Time: ${timestamp}`;
        statusSuccess.classList.add("show");
      }

      // Show not found status
      function showError() {
        hideAllStatus();
        statusError.classList.add("show");
      }

      // Sanitize tracking number input
      function sanitizeTrackingNumber(value) {
        return value
          .replace(/[\s\-]/g, "")
          .toUpperCase()
          .trim();
      }

      // Detect carrier from tracking number
      function detectCarrier(trackingNumber) {
        const tn = trackingNumber.toUpperCase();
        if (tn.startsWith('1Z')) {
          return 'UPS';
        }
        // FedEx: 12, 14, 15, 20, 22 digits
        if (/^\d{12}$|^\d{14}$|^\d{15}$|^\d{20}$|^\d{22}$/.test(tn)) {
          return 'FedEx';
        }
        return 'FedEx'; // Default to FedEx for unknown
      }

      // Search tracking number
      async function checkTracking() {
        const rawValue = trackingInput.value;
        const trackingNumber = sanitizeTrackingNumber(rawValue);

        if (!trackingNumber) {
          alert("Please enter a tracking number");
          return;
        }

        showLoading();

        try {
          const response = await fetch("/api/check", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ trackingNumber }),
          });

          const data = await response.json();

          if (data.exists) {
            showSuccess(data.createdAt);
          } else {
            showError();
          }
        } catch (error) {
          console.error("Search failed:", error);
          alert("Search failed. Please check your connection and try again.");
          hideAllStatus();
        }
      }

      // Start barcode scanner
      async function startScanner() {
        try {
          scannerOverlay.classList.add("active");
          isScanning = true;

          // Only include formats actually used by FedEx (Code 128) and UPS (Code 128).
          // Scanning fewer formats means each frame decodes faster.
          const hints = new Map();
          hints.set(DecodeHintType.POSSIBLE_FORMATS, [
            BarcodeFormat.CODE_128,
            BarcodeFormat.ITF, // FedEx Ground also uses ITF-14
          ]);
          hints.set(DecodeHintType.TRY_HARDER, true);

          codeReader = new BrowserMultiFormatReader(hints);

          let hasDetected = false; // Prevent multiple detections

          // Higher resolution gives ZXing more pixels to resolve the dense
          // bars in long FedEx Code 128 barcodes.
          scannerControls = await codeReader.decodeFromConstraints(
            { video: { facingMode: "environment", width: { ideal: 1920 }, height: { ideal: 1080 } } },
            scannerVideo,
            (result, error) => {
              if (result && isScanning && !hasDetected) {
                hasDetected = true; // Mark as detected
                const text = result.getText();
                console.log("Barcode detected:", text);
                handleBarcodeResult(text);
              }
              if (error && error.name !== 'NotFoundException') {
                console.error("Scan error:", error);
              }
            }
          );
        } catch (err) {
          console.error("Failed to start scanner:", err);
          alert("Unable to access camera. Please ensure camera permissions are granted.");
          stopScanner();
        }
      }

      // Show scan result modal
      function showScanResultModal(trackingNumber, carrier, rawText) {
        try {
          pendingScanData = { trackingNumber, carrier, rawText };
          
          if (!scanResultModal || !scanResultTracking || !scanResultCarrier) {
            console.error("Modal elements not found:", { 
              scanResultModal, 
              scanResultTracking, 
              scanResultCarrier 
            });
            alert("UI Error: Modal elements not found. Please refresh.");
            return;
          }
          
          scanResultTracking.textContent = trackingNumber;
          scanResultCarrier.innerHTML = `<span class="carrier-badge ${carrier.toLowerCase()}">${carrier}</span>`;
          scanResultRaw.textContent = rawText.substring(0, 30) + (rawText.length > 30 ? '...' : '');
          
          scanResultModal.classList.add("active");
          scanResultSave.disabled = false;
          scanResultSave.textContent = "Save & Check";
          
          console.log("Modal shown successfully");
        } catch (err) {
          console.error("Error showing modal:", err);
          alert("Error showing scan result: " + err.message);
        }
      }

      // Hide scan result modal
      function hideScanResultModal() {
        scanResultModal.classList.remove("active");
        pendingScanData = null;
      }

      // Handle save from modal
      async function handleScanSave() {
        if (!pendingScanData) return;
        
        scanResultSave.disabled = true;
        scanResultSave.textContent = "Saving...";
        
        const { trackingNumber, carrier } = pendingScanData;
        
        try {
          // Send to server to save
          const response = await fetch("/api/save-label", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              trackingNumber: trackingNumber,
              carrier: carrier,
              shipperFirstName: null,
              shipperLastName: null,
            }),
          });

          const data = await response.json();
          
          hideScanResultModal();
          
          if (data.success) {
            trackingInput.value = trackingNumber;
            showSuccess(data.createdAt);
            loadLabels();
          } else {
            // If already exists or other error
            trackingInput.value = trackingNumber;
            checkTracking();
          }
        } catch (error) {
          console.error("Save failed:", error);
          hideScanResultModal();
          alert("Save failed. Please try again.");
        }
      }

      // Handle scanned barcode
      function handleBarcodeResult(text) {
        try {
          console.log("handleBarcodeResult called with:", text);
          isScanning = false;
          
          const rawText = text.trim().toUpperCase();

          // Strip everything except A-Z0-9 and uppercase
          const cleaned = rawText.replace(/[^A-Z0-9]/gi, '').toUpperCase();

          let trackingNumber = null;

          // UPS: 1Z + 16 alphanumeric chars
          const upsMatch = cleaned.match(/1Z[A-Z0-9]{16}/);
          if (upsMatch) {
            trackingNumber = upsMatch[0];
          }

          if (!trackingNumber) {
            // FedEx: long digit sequences (22-40 digits) → take last 12
            const fedexLong = [...cleaned.matchAll(/\d{22,40}/g)];
            if (fedexLong.length > 0) {
              trackingNumber = fedexLong[fedexLong.length - 1][0].slice(-12);
            }
          }

          if (!trackingNumber) {
            // FedEx fallback: take last 12 digits from all digits in cleaned string
            const digits = cleaned.replace(/\D/g, '');
            if (digits.length >= 12) {
              trackingNumber = digits.slice(-12);
            }
          }

          if (!trackingNumber) {
            trackingNumber = cleaned; // last resort: use as-is
          }
          
          console.log("Processed tracking number:", trackingNumber);
          
          // Stop scanner
          if (scannerControls) {
            scannerControls.stop();
            scannerControls = null;
          }
          codeReader = null;
          
          // Stop video stream
          if (scannerVideo && scannerVideo.srcObject) {
            const tracks = scannerVideo.srcObject.getTracks();
            tracks.forEach(track => track.stop());
            scannerVideo.srcObject = null;
          }
          
          // Hide scanner overlay
          scannerOverlay.classList.remove("active");
          
          // Detect carrier
          const carrier = detectCarrier(trackingNumber);
          
          console.log("Showing modal with:", { trackingNumber, carrier, rawText });
          
          // Show confirmation modal
          showScanResultModal(trackingNumber, carrier, rawText);
        } catch (err) {
          console.error("Error in handleBarcodeResult:", err);
          alert("Scan processing error: " + err.message);
          stopScanner();
        }
      }

      // Stop scanner
      function stopScanner() {
        isScanning = false;
        scannerOverlay.classList.remove("active");
        manualInputPanel.classList.remove("active");
        
        if (scannerControls) {
          scannerControls.stop();
          scannerControls = null;
        }
        codeReader = null;

        // Stop video stream
        if (scannerVideo.srcObject) {
          const tracks = scannerVideo.srcObject.getTracks();
          tracks.forEach(track => track.stop());
          scannerVideo.srcObject = null;
        }
      }

      // Show manual input panel
      function showManualInput() {
        manualInputPanel.classList.add("active");
        manualInputField.value = "";
        manualInputField.focus();
      }

      // Hide manual input panel
      function hideManualInput() {
        manualInputPanel.classList.remove("active");
      }

      // Handle manual input confirm
      function confirmManualInput() {
        const value = manualInputField.value.trim();
        if (value) {
          stopScanner();
          trackingInput.value = value.toUpperCase();
          checkTracking();
        }
      }

      // Event listeners
      searchBtn.addEventListener("click", checkTracking);

      trackingInput.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          checkTracking();
        }
      });

      cameraBtn.addEventListener("click", startScanner);
      scannerClose.addEventListener("click", stopScanner);
      scannerManualBtn.addEventListener("click", showManualInput);
      manualCancelBtn.addEventListener("click", hideManualInput);
      manualConfirmBtn.addEventListener("click", confirmManualInput);
      
      manualInputField.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          confirmManualInput();
        }
      });
      
      // Scan result modal event listeners
      scanResultCancel.addEventListener("click", hideScanResultModal);
      scanResultSave.addEventListener("click", handleScanSave);

      // Auto uppercase on input
      trackingInput.addEventListener("input", (e) => {
        e.target.value = e.target.value.toUpperCase();
      });

      // Labels List
      const labelsList = document.getElementById("labelsList");
      const labelsCount = document.getElementById("labelsCount");

      async function loadLabels() {
        try {
          const response = await fetch("/api/labels?limit=20");
          const data = await response.json();

          if (!data.success) {
            throw new Error(data.error);
          }

          labelsCount.textContent = `${data.count} entries`;

          if (data.labels.length === 0) {
            labelsList.innerHTML = `
            <div class="labels-empty">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6 4.125l2.25 2.25m0 0l2.25 2.25M12 13.875l2.25-2.25M12 13.875l-2.25 2.25M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
              <div>No entries yet</div>
              <div style="font-size: 0.75rem; margin-top: 0.5rem;">Scan a barcode to get started</div>
            </div>
          `;
            return;
          }

          labelsList.innerHTML = data.labels
            .map((label) => {
              const shipperName =
                label.shipperFirstName || label.shipperLastName
                  ? `${label.shipperFirstName || ""} ${
                      label.shipperLastName || ""
                    }`.trim()
                  : null;
              return `
          <div class="label-item" data-id="${label.id}" data-tracking="${
                label.trackingNumber
              }">
            <div class="label-carrier ${label.carrier.toLowerCase()}">${
                label.carrier
              }</div>
            <div class="label-info">
              <div class="label-tracking">${label.trackingNumber}</div>
              <div class="label-meta">${label.createdAt}</div>
              ${
                shipperName
                  ? `<div class="label-shipper">From: ${shipperName}</div>`
                  : ""
              }
            </div>
            <button class="label-delete" title="Delete" data-id="${label.id}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
              </svg>
            </button>
          </div>
        `;
            })
            .join("");

          // Click to fill input
          labelsList.querySelectorAll(".label-item").forEach((item) => {
            item.addEventListener("click", (e) => {
              // Don't trigger if clicked delete button
              if (e.target.closest(".label-delete")) return;
              trackingInput.value = item.dataset.tracking;
              checkTracking();
            });
          });

          // Delete button
          labelsList.querySelectorAll(".label-delete").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
              e.stopPropagation();
              const id = parseInt(btn.dataset.id);
              const item = btn.closest(".label-item");
              const trackingNumber = item.dataset.tracking;

              if (
                !confirm(
                  `Delete "${trackingNumber}"?\n\nThis action cannot be undone.`
                )
              ) {
                return;
              }

              try {
                const response = await fetch("/api/delete", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ id }),
                });

                const data = await response.json();

                if (data.success) {
                  // Animate removal
                  item.style.transition = "all 0.3s";
                  item.style.opacity = "0";
                  item.style.transform = "translateX(20px)";
                  setTimeout(() => {
                    item.remove();
                    // Update count
                    const currentCount = parseInt(labelsCount.textContent) || 0;
                    labelsCount.textContent = `${Math.max(
                      0,
                      currentCount - 1
                    )} entries`;
                    // If no items left, show empty state
                    if (labelsList.children.length === 0) {
                      loadLabels();
                    }
                  }, 300);
                } else {
                  alert(data.error || "Delete failed");
                }
              } catch (error) {
                console.error("Delete failed:", error);
                alert("Delete failed. Please try again.");
              }
            });
          });
        } catch (error) {
          console.error("Failed to load labels:", error);
          labelsList.innerHTML = `
          <div class="labels-empty">
            <div>Failed to load</div>
            <div style="font-size: 0.75rem; margin-top: 0.5rem;">Please refresh to try again</div>
          </div>
        `;
          labelsCount.textContent = "Error";
        }
      }

      // Load labels on page load
      loadLabels();
    </script>
  </body>
</html>
