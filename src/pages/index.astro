    </main>

    <footer class="footer">SnapTrack MVP v1.0 · Cloudflare Edge</footer>

    <!-- Scan Result Modal -->
    <div class="scan-result-modal" id="scanResultModal">
      <div class="scan-result-card">
        <div class="scan-result-header">
          <div class="scan-result-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75v-.75zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75v-.75zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75v-.75zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75v-.75z" />
            </svg>
          </div>
          <div class="scan-result-title">Barcode Detected</div>
          <div class="scan-result-subtitle">Review and confirm to save</div>
        </div>
        
        <div class="scan-result-data">
          <div class="scan-result-row">
            <span class="scan-result-label">Tracking Number</span>
            <span class="scan-result-value tracking" id="scanResultTracking">-</span>
          </div>
          <div class="scan-result-row">
            <span class="scan-result-label">Carrier</span>
            <span class="scan-result-value carrier" id="scanResultCarrier">-</span>
          </div>
          <div class="scan-result-row">
            <span class="scan-result-label">Raw Data</span>
            <span class="scan-result-value" id="scanResultRaw" style="font-size: 0.75rem; max-width: 150px; overflow: hidden; text-overflow: ellipsis;">-</span>
          </div>
        </div>
        
        <div class="scan-result-buttons">
          <button class="scan-result-btn cancel" id="scanResultCancel">Cancel</button>
          <button class="scan-result-btn save" id="scanResultSave">Save & Check</button>
        </div>
      </div>
